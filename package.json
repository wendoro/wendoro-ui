{
  "name": "@wendoro/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wendoro UI — Shared design system and reusable component library for the Wendoro software ecosystem.",
  "homepage": "https://wendoro.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoro/wendoro-ui.git"
  },
  "license": "MIT",
  "main": "./dist/lib/wendoro-ui.cjs",
  "module": "./dist/lib/wendoro-ui.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/wendoro-ui.js",
      "require": "./dist/lib/wendoro-ui.cjs"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./themes/light.css": "./src/themes/light.css",
    "./themes/dark.css": "./src/themes/dark.css",
    "./themes/high-contrast.css": "./src/themes/high-contrast.css",
    "./tokens": {
      "types": "./dist/lib/tokens/index.d.ts",
      "import": "./dist/lib/tokens/index.js",
      "require": "./dist/lib/tokens/index.cjs"
    },
    "./charts": {
      "types": "./dist/lib/components/charts/index.d.ts",
      "import": "./dist/lib/charts/index.js",
      "require": "./dist/lib/charts/index.cjs"
    },
    "./charts/advanced": {
      "types": "./dist/lib/components/charts/advanced/index.d.ts",
      "import": "./dist/lib/charts/advanced/index.js",
      "require": "./dist/lib/charts/advanced/index.cjs"
    },
    "./business": {
      "types": "./dist/lib/components/business/index.d.ts",
      "import": "./dist/lib/business/index.js",
      "require": "./dist/lib/business/index.cjs"
    },
    "./hooks": {
      "types": "./dist/lib/hooks/index.d.ts",
      "import": "./dist/lib/hooks/index.js",
      "require": "./dist/lib/hooks/index.cjs"
    }
  },
  "files": [
    "dist/lib",
    "src/styles",
    "src/themes",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "build:lib": "rm -rf dist/lib && tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts && vite build --config vite.styles.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src stories tests",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "npm run build:lib && tsc -p tests/integration/consumer-fixture/tsconfig.consumer.json --noEmit && vitest run --config vitest.integration.config.ts",
    "test:ci": "npm run typecheck && npm run lint && npm run test:run && npm run test:integration && npm run build && npm run build-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@storybook/addon-a11y": "^8.5.8",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/blocks": "^8.5.8",
    "@storybook/react-vite": "^8.5.8",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.5.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.11",
    "vitest": "^2.1.8"
  }
}
