{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/lib",
    "allowImportingTsExtensions": false,
    "rootDir": "./src"
  },
  "include": ["src/index.ts", "src/tokens", "src/components", "src/hooks", "src/utils"],
  "exclude": ["src/app", "src/main.tsx", "src/App.tsx", "tests", "stories"]
}
